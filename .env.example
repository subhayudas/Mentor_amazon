# ─── Vercel serverless functions (api/) ───────────────────────────────────────
# These are SERVER-SIDE ONLY. Never prefix them with VITE_ and never reference
# them from client/ — anything with a VITE_ prefix is inlined into the browser
# bundle.
#
# Set them in the Vercel project (Settings → Environment Variables) for both
# Production and Preview. For local `vercel dev`, put them in a root .env.

# Amazon Federate (OIDC, authorization code + PKCE, confidential client)
AMAZON_OIDC_ISSUER=replace-me                   # integ: https://idp-integ.federate.amazon.com  prod: https://idp.federate.amazon.com
AMAZON_OIDC_CLIENT_ID=mentor-amazon.vercel.app  # integ; Amazon expects the same for prod
AMAZON_OIDC_CLIENT_SECRET=replace-me            # from Amazon's identity team; server-side only
# Exact-match redirect URI registered with Amazon (no trailing slash). Do not change.
AMAZON_OIDC_REDIRECT_URI=https://mentor-amazon.vercel.app/api/auth/callback/amazon
AMAZON_OIDC_SCOPES=openid                 # optional; default shown (the only scope Federate supports)
# Optional: 'true' enables GET /api/auth/debug-claims (integ only, never in prod)
AMAZON_OIDC_DEBUG=false

# Supabase admin access for the SSO bridge (creates users, issues sessions)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me            # server-side only; bypasses RLS

# Public site origin used for post-login redirects
APP_ORIGIN=https://mentor-amazon.vercel.app

# Cal.com webhook (POST /api/webhooks/cal). Each mentor's webhook has its own secret,
# kept in the database and shown in their "Cal.com booking sync" panel; nothing to set
# for that. OPTIONAL: a global secret only for a programme Cal.com Team/Org webhook that
# posts without ?mentor= (at least 16 characters, e.g. `openssl rand -hex 32`). Empty = off.
CAL_WEBHOOK_SECRET=

# Reminder cron (GET /api/cron/reminders): triggered hourly by the GitHub Actions
# workflow .github/workflows/reminders.yml, which sends `Authorization: Bearer
# $CRON_SECRET`. Set the same value here and as the repository secret CRON_SECRET.
CRON_SECRET=replace-me-with-16-plus-random-chars

# Email (optional). When set, reminders (and future notifications) are also
# emailed through Resend from MAIL_FROM (a verified domain in Resend).
RESEND_API_KEY=
MAIL_FROM=MentorConnect <mentors@your-domain.com>

# Bot protection on anonymous booking requests (POST /api/requests), optional.
# Cloudflare Turnstile: the site key goes in client/.env as VITE_TURNSTILE_SITE_KEY
# (and must also be visible to the functions, as it is on Vercel), the secret here.
# Set both or neither: a site key without the secret makes /api/requests refuse (503).
TURNSTILE_SECRET_KEY=
# Optional: hostnames a token must have been issued on, comma-separated.
TURNSTILE_ALLOWED_HOSTNAMES=

# Distributed IP rate limiting (optional). Without these the limiter is
# per-function-instance (in memory). Upstash Redis REST credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Client (client/.env) ─────────────────────────────────────────────────────
# See client/.env.example — VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY.
