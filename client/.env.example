# Supabase Configuration
# Get these values from your Supabase Dashboard:
# https://supabase.com/dashboard -> Your Project -> Settings -> API
#
# BOTH are REQUIRED. The app throws on startup if either is missing --
# there are no fallback values. For Vercel, set these in the project's
# environment variables for Production and Preview (everything in this file is set
# for both, except VITE_TURNSTILE_SITE_KEY, which is Production only).

VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Note: The anon key is safe to expose publicly
# It only allows operations permitted by your Row Level Security (RLS) policies

# Optional: programme contact shown on the mentee dashboard when an organisation's verification is not approved
VITE_PROGRAMME_CONTACT_EMAIL=

# Cloudflare Turnstile site key — the bot check on anonymous booking requests and on
# sign-up / sign-in / password reset. Required in Production (with the server-side
# TURNSTILE_SECRET_KEY; without both, Production refuses anonymous requests with 503
# captcha_unavailable). Production environment only: on Preview leave it unset, because
# the production widget rejects preview hostnames and the sign-in forms need a token
# whenever this key is set (a preview then refuses anonymous requests: it writes to the
# production database). Cloudflare's always-pass test site key 1x00000000000000000000AA
# (secret 1x0000000000000000000000000000000AA) is for local development only. Switch on
# Supabase Auth captcha only after a client with this key is live.
VITE_TURNSTILE_SITE_KEY=

# Optional: the production origin shown in the mentors' "Cal.com booking sync" panel
# (defaults to the current site's origin).
VITE_PUBLIC_APP_ORIGIN=

# Dev/preview ONLY, never Production: '1' lets the app fall back to browser-only demo
# mode when Supabase cannot be reached (always on under `vite` dev).
# VITE_ALLOW_LOCAL_FALLBACK=1
