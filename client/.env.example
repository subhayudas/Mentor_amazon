# Supabase Configuration
# Get these values from your Supabase Dashboard:
# https://supabase.com/dashboard -> Your Project -> Settings -> API
#
# BOTH are REQUIRED. The app throws on startup if either is missing --
# there are no fallback values. For Vercel, set these in the project's
# environment variables for BOTH Production and Preview.

VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Note: The anon key is safe to expose publicly
# It only allows operations permitted by your Row Level Security (RLS) policies

